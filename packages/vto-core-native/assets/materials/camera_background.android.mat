material {
    name : camera_feed,
    shadingModel : unlit,
    vertexDomain : device,
    depthWrite : false,
    depthCulling : false,
    requires : [
        uv0
    ],
    parameters : [
        {
            type : samplerExternal,
            name : cameraTexture
        }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 uv = getUV0();
        vec4 color = texture(materialParams_cameraTexture, uv);
        // ARCore's camera feed comes through samplerExternalOES already display-ready.
        // It still reads visibly brighter than iOS's ARKit feed, so we scale down to match.
        // Tweak this value if a future device calibration drifts.
        color.rgb *= 0.90;
        // Camera feed is display-encoded; the piecewise sRGB→linear decode
        // is the exact inverse of the view's sRGB encoder, and the view's
        // tone mapping is linear (ADR 0019), so the direct-view round-trip
        // is identity and the refraction pass samples the true feed.
        color.rgb = mix(
            color.rgb / 12.92,
            pow((color.rgb + 0.055) / 1.055, vec3(2.4)),
            step(0.04045, color.rgb)
        );
        material.baseColor = color;
    }
}
