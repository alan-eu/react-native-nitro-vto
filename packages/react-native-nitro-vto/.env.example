# Copy this file to .env and set the right paths for Filament binaries
# Download Filament releases from https://github.com/google/filament/releases

# matc - Material compiler (.mat -> .filamat)
MATC_IOS_PATH=/path/to/filament/bin/matc
MATC_ANDROID_PATH=/path/to/filament/bin/matc

# cmgen - Environment map generator (.hdr -> .ktx)
CMGEN_IOS_PATH=/path/to/filament/bin/cmgen
CMGEN_ANDROID_PATH=/path/to/filament/bin/cmgen
