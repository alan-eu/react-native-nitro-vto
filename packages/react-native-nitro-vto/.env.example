# Copy this file to .env and set the right paths for Filament binaries
# Download Filament releases from https://github.com/google/filament/releases

# matc - Material compiler (.mat -> .filamat)
# Used by `npm run matc` (compiles for iOS and Android in one pass)
MATC_PATH=/path/to/filament/bin/matc

# cmgen - Environment map generator (.hdr -> .ktx + _sh.txt)
# Used by `npm run cmgen` (outputs are platform-agnostic and copied to both platforms)
CMGEN_PATH=/path/to/filament/bin/cmgen
