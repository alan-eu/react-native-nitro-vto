material {
    name : camera_feed,
    shadingModel : unlit,
    vertexDomain : device,
    depthCulling : false,
    depthWrite : false,
    requires : [
        uv0
    ],
    flipUV : false,
    parameters : [
        {
            type : sampler2d,
            name : cameraFeed
        },
        {
            type : float3x3,
            name : textureTransform
        }
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.uv0 = (materialParams.textureTransform * float3(material.uv0, 1.0)).rg;
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 uv = getUV0();
        vec4 color = texture(materialParams_cameraFeed, uv);
        // Camera feed is display-encoded; the piecewise sRGB→linear decode
        // is the exact inverse of the view's sRGB encoder, and the view's
        // tone mapping is linear (ADR 0019), so the direct-view round-trip
        // is identity and the refraction pass samples the true feed.
        color.rgb = mix(
            color.rgb / 12.92,
            pow((color.rgb + 0.055) / 1.055, vec3(2.4)),
            step(0.04045, color.rgb)
        );
        material.baseColor = color;
    }
}
